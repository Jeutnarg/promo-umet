{
  "name": "promotion-sandbox-frontends",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:customer": "tsc --noEmit && node ../scripts/build-app.mjs customer",
    "build:admin": "tsc --noEmit && node ../scripts/build-app.mjs admin",
    "generate": "openapi-typescript ../backend/target/openapi.json -o src/generated/schema.ts && node ../scripts/generate-client.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/raleway": "5.2.5",
    "oidc-client-ts": "3.2.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.3.4",
    "openapi-typescript": "7.6.1",
    "prettier": "3.6.2",
    "typescript": "5.8.2",
    "vite": "6.4.5"
  }
}
